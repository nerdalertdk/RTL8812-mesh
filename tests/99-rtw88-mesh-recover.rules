# Rebuild the test mesh when either USB radio creates a fresh netdev.
# Replace the two placeholder addresses before installing this rule.
ACTION=="add", SUBSYSTEM=="net", ATTR{address}=="02:00:00:00:00:01", TAG+="systemd", ENV{SYSTEMD_WANTS}+="rtw88-mesh-recover.service"
ACTION=="add", SUBSYSTEM=="net", ATTR{address}=="02:00:00:00:00:02", TAG+="systemd", ENV{SYSTEMD_WANTS}+="rtw88-mesh-recover.service"
