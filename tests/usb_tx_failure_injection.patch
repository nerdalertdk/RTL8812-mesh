diff --git a/usb.c b/usb.c
index 07d3fc0..f4767da 100644
--- a/usb.c
+++ b/usb.c
@@ -5,6 +5,7 @@
 #include <linux/module.h>
 #include <linux/usb.h>
 #include <linux/mutex.h>
+#include <linux/delay.h>
 #include "main.h"
 #include "debug.h"
 #include "mac.h"
@@ -376,6 +377,48 @@ static int rtw_usb_parse(struct rtw_dev *rtwdev,
 	return 0;
 }
 
+/* Test-only pre-submit and completion fault injection. This belongs only in
+ * an isolated hardware-in-loop build; do not submit it with the driver.
+ */
+static int rtw_usb_test_tx_submit;
+static int rtw_usb_test_tx_agg_submit;
+static int rtw_usb_test_tx_complete;
+static int rtw_usb_test_tx_delays;
+static char rtw_usb_test_dev[32];
+module_param_named(test_tx_submit_failures,
+		   rtw_usb_test_tx_submit, int, 0600);
+module_param_named(test_tx_agg_submit_failures,
+		   rtw_usb_test_tx_agg_submit, int, 0600);
+module_param_named(test_tx_completion_failures,
+		   rtw_usb_test_tx_complete, int, 0600);
+module_param_named(test_tx_completion_delays,
+		   rtw_usb_test_tx_delays, int, 0600);
+module_param_string(test_tx_completion_delay_device,
+		    rtw_usb_test_dev, sizeof(rtw_usb_test_dev), 0600);
+MODULE_PARM_DESC(test_tx_submit_failures,
+		 "number of RTL88 USB TX submissions to fail with -EPROTO");
+MODULE_PARM_DESC(test_tx_agg_submit_failures,
+		 "number of aggregated RTL88 USB TX submissions to reject");
+MODULE_PARM_DESC(test_tx_completion_failures,
+		 "number of RTL88 USB TX completions to report as -EPROTO");
+MODULE_PARM_DESC(test_tx_completion_delays,
+		 "number of RTL88 USB TX completions to delay by five seconds");
+MODULE_PARM_DESC(test_tx_completion_delay_device,
+		 "USB interface name whose RTL88 TX completion may be delayed");
+
+static bool rtw_usb_test_take(int *remaining_count)
+{
+	int remaining;
+
+	do {
+		remaining = READ_ONCE(*remaining_count);
+		if (remaining <= 0)
+			return false;
+	} while (cmpxchg(remaining_count, remaining, remaining - 1) != remaining);
+
+	return true;
+}
+
 static void rtw_usb_record_tx_error(struct rtw_dev *rtwdev, int status)
 {
 	struct rtw_usb *rtwusb = rtw_get_usb_priv(rtwdev);
@@ -446,8 +489,17 @@ static void rtw_usb_write_port_tx_status(struct rtw_usb_txcb *txcb, int status)
 static void rtw_usb_write_port_tx_complete(struct urb *urb)
 {
 	struct rtw_usb_txcb *txcb = urb->context;
+	int status = urb->status;
+	bool delay;
 
-	rtw_usb_write_port_tx_status(txcb, urb->status);
+	delay = sysfs_streq(rtw_usb_test_dev, dev_name(txcb->rtwdev->dev));
+	if (unlikely(delay && rtw_usb_test_take(&rtw_usb_test_tx_delays)))
+		mdelay(5000);
+
+	if (unlikely(rtw_usb_test_take(&rtw_usb_test_tx_complete)))
+		status = -EPROTO;
+
+	rtw_usb_write_port_tx_status(txcb, status);
 }
 
 static int qsel_to_ep(struct rtw_usb *rtwusb, unsigned int qsel)
@@ -479,7 +531,10 @@ static int rtw_usb_write_port(struct rtw_dev *rtwdev, u8 qsel, struct sk_buff *s
 	usb_fill_bulk_urb(urb, usbd, pipe, skb->data, skb->len, cb, context);
 	urb->transfer_flags |= URB_ZERO_PACKET;
 	usb_anchor_urb(urb, &rtwusb->tx_anchor);
-	ret = usb_submit_urb(urb, GFP_ATOMIC);
+	if (unlikely(rtw_usb_test_take(&rtw_usb_test_tx_submit)))
+		ret = -EPROTO;
+	else
+		ret = usb_submit_urb(urb, GFP_ATOMIC);
 	if (ret)
 		usb_unanchor_urb(urb);
 
@@ -496,6 +551,7 @@ static bool rtw_usb_tx_agg_skb(struct rtw_usb *rtwusb, struct sk_buff_head *list)
 	struct sk_buff *skb_iter;
 	int agg_num = 0;
 	int ret;
+	unsigned int test_agg_originals = 0;
 	unsigned int align_next = 0;
 	u8 qsel;
 
@@ -563,14 +619,28 @@ queue:
 	tx_desc = (struct rtw_tx_desc *)skb_head->data;
 	qsel = le32_get_bits(tx_desc->w1, RTW_TX_DESC_W1_QSEL);
 
-	ret = rtw_usb_write_port(rtwdev, qsel, skb_head,
-				 rtw_usb_write_port_tx_complete, txcb);
+	if (txcb->agg_skb && skb_queue_len(&txcb->tx_ack_queue) > 1 &&
+	    unlikely(rtw_usb_test_take(&rtw_usb_test_tx_agg_submit))) {
+		test_agg_originals = skb_queue_len(&txcb->tx_ack_queue);
+
+		rtw_info(rtwdev,
+			 "test: rejecting aggregate USB TX originals=%u bytes=%u\n",
+			 test_agg_originals, skb_head->len);
+		ret = -EPROTO;
+	} else {
+		ret = rtw_usb_write_port(rtwdev, qsel, skb_head,
+					 rtw_usb_write_port_tx_complete, txcb);
+	}
 	if (ret) {
 		rtw_usb_record_tx_error(rtwdev, ret);
 		if (txcb->agg_skb)
 			dev_kfree_skb_any(txcb->agg_skb);
 		while ((skb_iter = skb_dequeue(&txcb->tx_ack_queue)))
 			ieee80211_free_txskb(rtwdev->hw, skb_iter);
+		if (test_agg_originals)
+			rtw_info(rtwdev,
+				 "test: cleaned rejected aggregate USB TX originals=%u\n",
+				 test_agg_originals);
 		kfree(txcb);
 	}
 
@@ -1255,7 +1325,15 @@ static void rtw_usb_deinit_tx(struct rtw_dev *rtwdev)
 	rtw_usb_tx_queue_purge(rtwusb);
 #endif
 	destroy_workqueue(rtwusb->txwq);
+	rtw_info(rtwdev,
+		 "test: USB TX anchor before kill pending_urbs=%d active_callbacks=%d\n",
+		 !usb_anchor_empty(&rtwusb->tx_anchor),
+		 atomic_read(&rtwusb->tx_anchor.suspend_wakeups));
 	usb_kill_anchored_urbs(&rtwusb->tx_anchor);
+	rtw_info(rtwdev,
+		 "test: USB TX anchor after kill pending_urbs=%d active_callbacks=%d\n",
+		 !usb_anchor_empty(&rtwusb->tx_anchor),
+		 atomic_read(&rtwusb->tx_anchor.suspend_wakeups));
 #if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 13, 0)
 	rtw_usb_tx_queue_purge(rtwusb);
 #endif
