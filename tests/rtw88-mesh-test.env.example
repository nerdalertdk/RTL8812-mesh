# Copy to /etc/default/rtw88-mesh-test and replace both example addresses.
ROOT_MAC=02:00:00:00:00:01
PEER_MAC=02:00:00:00:00:02
# Set this to `rtw_8812au` for the production two-adapter gate. The current
# mixed-peer fixture uses `rtl8xxxu`.
PEER_DRIVER=rtw_8812au
# Automatic recovery fails closed unless this exact DKMS package is installed
# and loaded from updates/dkms for the running kernel and architecture.
EXPECTED_VERSION=0.1.6
