[Unit]
Description=Reconstruct the RTL8812AU/RTL8192FU test mesh after USB re-enumeration
After=NetworkManager.service
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=oneshot
EnvironmentFile=/etc/default/rtw88-mesh-test
ExecStartPre=/usr/bin/sleep 2
ExecStart=/usr/local/libexec/rtw88-mesh-recover
Restart=on-failure
RestartSec=2
TimeoutStartSec=240
